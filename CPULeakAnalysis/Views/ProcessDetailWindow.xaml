<Window x:Class="CPULeakAnalysis.Views.ProcessDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CPULeakAnalysis.Controls"
        Title="{Binding WindowTitle}"
        Width="1250"
        Height="800"
        MinWidth="900"
        MinHeight="600"
        Background="#11151C"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="18">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="340"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header and graph controls -->

        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>

                <TextBlock Text="CPU Process Detail"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="White"/>

                <TextBlock Text="{Binding ProcessDescription}"
                           Foreground="#AAB4C6"
                           FontSize="14"/>

            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                <TextBlock Text="Graph range"
                           Margin="0,0,7,0"
                           Foreground="White"
                           VerticalAlignment="Center"/>

                <ComboBox Width="120"
                          Margin="0,0,18,0"
                          ItemsSource="{Binding TimeRanges}"
                          SelectedItem="{Binding SelectedTimeRange,
                                                 Mode=TwoWay,
                                                 UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="CPU scale"
                           Margin="0,0,7,0"
                           Foreground="White"
                           VerticalAlignment="Center"/>

                <Slider Width="170"
                        Minimum="10"
                        Maximum="100"
                        TickFrequency="10"
                        IsSnapToTickEnabled="True"
                        Value="{Binding ZoomPercent,
                                        Mode=TwoWay,
                                        UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Width="52"
                           Margin="8,0,0,0"
                           Foreground="White"
                           VerticalAlignment="Center">

                    <Run Text="{Binding ZoomPercent}"/>
                    <Run Text="%"/>

                </TextBlock>

            </StackPanel>

        </Grid>

        <!-- Chart -->

        <Border Grid.Row="1"
                Margin="0,18,0,12"
                CornerRadius="8"
                BorderBrush="#354052"
                BorderThickness="1"
                Background="#181C24">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Dynamic Y-axis labels -->

                <Grid Grid.Column="0"
                      Margin="6,10,6,10">

                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="{Binding AxisTopLabel}"
                               Foreground="White"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Top"/>

                    <TextBlock Grid.Row="1"
                               Text="{Binding Axis75Label}"
                               Foreground="White"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="2"
                               Text="{Binding Axis50Label}"
                               Foreground="White"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="3"
                               Text="{Binding Axis25Label}"
                               Foreground="White"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="4"
                               Text="{Binding AxisBottomLabel}"
                               Foreground="White"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Bottom"/>

                </Grid>

                <controls:CpuChart
                Grid.Column="1"
                ItemsSource="{Binding FilteredSamples}"
                TimeRange="{Binding SelectedTimeSpan}"
                ZoomPercent="{Binding ZoomPercent}" />

            </Grid>

        </Border>

        <!-- Selected-process data -->

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding FilteredSamples}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  Background="#1A202B"
                  Foreground="DarkBlue"
                  RowBackground="AliceBlue"
                  AlternatingRowBackground="LawnGreen"
                  BorderBrush="#354052"
                  BorderThickness="1"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Local Time"
                                    Width="180"
                                    Binding="{Binding LocalTimestamp,
                                                      StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"/>

                <DataGridTextColumn Header="Process"
                                    Width="*"
                                    Binding="{Binding ProcessName}"/>

                <DataGridTextColumn Header="PID"
                                    Width="80"
                                    Binding="{Binding ProcessId}"/>

                <DataGridTextColumn Header="CPU %"
                                    Width="90"
                                    Binding="{Binding CpuPercent,
                                                      StringFormat=F2}"/>

                <DataGridTextColumn Header="Working Set MB"
                                    Width="135"
                                    Binding="{Binding WorkingSetMb,
                                                      StringFormat=F1}"/>

                <DataGridTextColumn Header="Private MB"
                                    Width="120"
                                    Binding="{Binding PrivateMemoryMb,
                                                      StringFormat=F1}"/>

                <DataGridTextColumn Header="Handles"
                                    Width="90"
                                    Binding="{Binding HandleCount}"/>

                <DataGridTextColumn Header="Threads"
                                    Width="90"
                                    Binding="{Binding ThreadCount}"/>

            </DataGrid.Columns>

        </DataGrid>

        <!-- Footer -->

        <Grid Grid.Row="3"
              Margin="0,12,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Foreground="#AAB4C6"
                       VerticalAlignment="Center">

                <Run Text="Live detail view for "/>
                <Run Text="{Binding ProcessDescription, Mode=OneWay}"
                     FontWeight="SemiBold"/>
                <Run Text=". Data collection is controlled by the main window."/>

            </TextBlock>

            <Button Grid.Column="1"
                    Content="Close"
                    Width="90"
                    Padding="12,6"
                    IsCancel="True"/>

        </Grid>

    </Grid>

</Window>