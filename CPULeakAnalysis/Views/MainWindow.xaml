<Window x:Class="CPULeakAnalysis.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CPULeakAnalysis.ViewModels"
        xmlns:controls="clr-namespace:CPULeakAnalysis.Controls"
        Title="CPULeakAnalysis"
        Width="1280"
        Height="850"
        MinWidth="1000"
        MinHeight="700"
        Background="#11151C">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="18">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="320"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->

        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="CPU Leak Analysis"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="White"/>

                <TextBlock Text="Milestone processes only • SQLite history • long-term CPU trending"
                           Foreground="#AAB4C6"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                <TextBlock Text="Interval (sec)"
                           Foreground="White"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0"/>

                <TextBox Width="60"
                         Margin="0,0,12,0"
                         Text="{Binding SampleIntervalSeconds,
                                        UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Range"
                           Foreground="White"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0"/>

                <ComboBox Width="120"
                          Margin="0,0,12,0"
                          ItemsSource="{Binding TimeRanges}"
                          SelectedItem="{Binding SelectedTimeRange}"/>

                <TextBlock Text="Zoom"
                           Foreground="White"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0"/>

                <Slider Width="150"
                        Minimum="10"
                        Maximum="100"
                        TickFrequency="10"
                        IsSnapToTickEnabled="True"
                        Value="{Binding ZoomPercent}"/>

                <TextBlock Text="{Binding ZoomPercent}"
                           Foreground="White"
                           Margin="8,0,12,0"
                           VerticalAlignment="Center"/>

                <Button Content="{Binding MonitorButtonText}"
                        Command="{Binding ToggleMonitoringCommand}"
                        Padding="14,7"
                        Margin="0,0,8,0"/>

                <Button Content="Clear Database"
                        Command="{Binding ClearDatabaseCommand}"
                        Padding="14,7"
                        Background="#B33A3A"
                        Foreground="White"/>
            </StackPanel>

        </Grid>

        <!-- GRAPH -->

        <Border Grid.Row="1"
                Margin="0,18,0,12"
                CornerRadius="8"
                BorderBrush="#354052"
                BorderThickness="1"
                Background="#181D27">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="65"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Y AXIS -->

                <Grid Grid.Column="0"
                      Margin="4">

                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <!--<TextBlock Grid.Row="0"
                               Text="100%"
                               Foreground="White"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Top"/>

                    <TextBlock Grid.Row="1"
                               Text="75%"
                               Foreground="White"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="2"
                               Text="50%"
                               Foreground="White"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="3"
                               Text="25%"
                               Foreground="White"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="4"
                               Text="0%"
                               Foreground="White"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Bottom"/>-->

                </Grid>

                <!-- CPU GRAPH -->

                <controls:CpuChart
                    Grid.Column="1"
                    Margin="8"
                    ItemsSource="{Binding Samples}"
                    ZoomPercent="{Binding ZoomPercent}" />

            </Grid>

        </Border>

        <!-- DATA GRID -->

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Samples}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  Background="#1A202B"
                  Foreground="Blue"
                  RowBackground="#1A202B"
                  AlternatingRowBackground="#202837"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal">

            <DataGrid.Columns>

                <DataGridTextColumn
                    Header="Local Time"
                    Width="180"
                    Binding="{Binding LocalTimestamp,
                                      StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"/>

                <DataGridTextColumn
                    Header="Process"
                    Width="*"
                    Binding="{Binding ProcessName}"/>

                <DataGridTextColumn
                    Header="PID"
                    Width="80"
                    Binding="{Binding ProcessId}"/>

                <DataGridTextColumn
                    Header="CPU %"
                    Width="90"
                    Binding="{Binding CpuPercent,
                                      StringFormat=F2}"/>

                <DataGridTextColumn
                    Header="Working Set MB"
                    Width="130"
                    Binding="{Binding WorkingSetMb,
                                      StringFormat=F1}"/>

                <DataGridTextColumn
                    Header="Private MB"
                    Width="120"
                    Binding="{Binding PrivateMemoryMb,
                                      StringFormat=F1}"/>

                <DataGridTextColumn
                    Header="Handles"
                    Width="90"
                    Binding="{Binding HandleCount}"/>

                <DataGridTextColumn
                    Header="Threads"
                    Width="90"
                    Binding="{Binding ThreadCount}"/>

            </DataGrid.Columns>

        </DataGrid>

        <!-- STATUS BAR -->

        <Grid Grid.Row="3" Margin="0,12,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>

                <TextBlock Text="{Binding Status}"
                           Foreground="#C9D3E5"/>

                <TextBlock Text="{Binding DatabasePath}"
                           Foreground="#71809A"
                           FontSize="11"/>

            </StackPanel>

            <TextBlock Grid.Column="1"
                       FontSize="20"
                       Foreground="White">

                <Run Text="Current Total CPU: "/>
                <Run Text="{Binding TotalCpuPercent,
                                    StringFormat=F2}"/>
                <Run Text="%"/>

            </TextBlock>

        </Grid>

    </Grid>

</Window>