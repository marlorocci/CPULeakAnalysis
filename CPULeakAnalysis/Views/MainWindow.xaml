<Window x:Class="CPULeakAnalysis.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CPULeakAnalysis.ViewModels"
        xmlns:controls="clr-namespace:CPULeakAnalysis.Controls"
        Title="CPULeakAnalysis"
        Width="1400"
        Height="900"
        MinWidth="1100"
        MinHeight="700"
        Background="#11151C">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="350"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->

        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>

                <TextBlock Text="CPU Leak Analysis"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="White"/>

                <TextBlock Text="Milestone Processes | SQLite History | Long-Term CPU Trending"
                           Foreground="#AAB4C6"/>

            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                
                
                <!--<TextBlock Text="PID"
                       Foreground="White"
                       VerticalAlignment="Center"
                       Margin="12,0,6,0"/>-->

                <!--<ComboBox Width="110"
                      Margin="0,0,8,0"
                      ItemsSource="{Binding ProcessIds}"
                      SelectedItem="{Binding SelectedProcessId}" />

                <Button Content="Filter"
                        Command="{Binding ApplyProcessFilterCommand}"
                        Padding="14,7"
                        Margin="0,0,8,0"/>

                <Button Content="Show All"
                        Command="{Binding ClearProcessFilterCommand}"
                        Padding="14,7"
                        Margin="0,0,8,0"/>-->      
                
                
                <TextBlock Text="Interval"
                           Foreground="White"
                           VerticalAlignment="Center"/>

                <TextBox Width="60"
                         Margin="5,0,15,0"
                         Text="{Binding SampleIntervalSeconds}" />

                <TextBlock Text="Range"
                           Foreground="White"
                           VerticalAlignment="Center"/>

                <ComboBox Width="120"
                          Margin="5,0,15,0"
                          ItemsSource="{Binding TimeRanges}"
                          SelectedItem="{Binding SelectedTimeRange}" />

                <TextBlock Text="Zoom %"
                           Foreground="White"
                           VerticalAlignment="Center"/>

                <Slider Width="125"
                        Margin="5,0,5,0"
                        Minimum="10"
                        Maximum="100"
                        Value="{Binding ZoomPercent}" />

                <TextBlock Text="{Binding ZoomPercent}"
                           Width="40"
                           Foreground="White"
                           VerticalAlignment="Center"/>

                <Button Content="{Binding MonitorButtonText}"
                        Command="{Binding ToggleMonitoringCommand}"
                        Padding="12,5"
                        Margin="10,0,5,0"/>

                <Button Content="Clear Database"
                        Command="{Binding ClearDatabaseCommand}"
                        Padding="12,5"
                        Background="#B33A3A"
                        Foreground="White"/>

            </StackPanel>

        </Grid>

        <!-- CHART -->

        <Border Grid.Row="1"
                Margin="0,15,0,10"
                CornerRadius="6"
                BorderBrush="#354052"
                BorderThickness="1"
                Background="#1A202B">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Y Axis -->

                <Grid Grid.Column="0"
          Margin="0,10,5,10">

                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                   Text="100%"
                   Foreground="White"
                   HorizontalAlignment="Right"/>

                    <TextBlock Grid.Row="1"
                   Text="75%"
                   Foreground="White"
                   HorizontalAlignment="Right"/>

                    <TextBlock Grid.Row="2"
                   Text="50%"
                   Foreground="White"
                   HorizontalAlignment="Right"/>

                    <TextBlock Grid.Row="3"
                   Text="25%"
                   Foreground="White"
                   HorizontalAlignment="Right"/>

                    <TextBlock Grid.Row="4"
                   Text="0%"
                   Foreground="White"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"/>

                </Grid>

                <!-- CPU CHART -->

                <controls:CpuChart
        Grid.Column="1"
        x:Name="CpuHistoryChart"
        Margin="5"
        ItemsSource="{Binding Samples}"
        TimeRange="{Binding SelectedTimeSpan}"
        ZoomPercent="{Binding ZoomPercent}" />

            </Grid>

        </Border>

        <!-- DATA GRID -->

        <DataGrid x:Name="ProcessDataGrid"
          Grid.Row="2"
          ItemsSource="{Binding Samples}"
          AutoGenerateColumns="False"
          IsReadOnly="True"
          SelectionMode="Single"
          SelectionUnit="FullRow"
          MouseDoubleClick="ProcessDataGrid_MouseDoubleClick"
          Background="AliceBlue"
          Foreground="DarkBlue"
          RowBackground="LightGray"
          AlternatingRowBackground="LightGreen"
          BorderBrush="#354052"
          BorderThickness="1"
          HeadersVisibility="Column"
          GridLinesVisibility="Horizontal">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Local Time"
                                    Width="170"
                                    Binding="{Binding LocalTimestamp,StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" />

                <DataGridTextColumn Header="Process"
                                    Width="*"
                                    Binding="{Binding ProcessName}" />

                <DataGridTextColumn Header="PID"
                                    Width="80"
                                    Binding="{Binding ProcessId}" />

                <DataGridTextColumn Header="CPU %"
                                    Width="80"
                                    Binding="{Binding CpuPercent,StringFormat=F2}" />

                <DataGridTextColumn Header="Working Set MB"
                                    Width="120"
                                    Binding="{Binding WorkingSetMb,StringFormat=F1}" />

                <DataGridTextColumn Header="Private MB"
                                    Width="120"
                                    Binding="{Binding PrivateMemoryMb,StringFormat=F1}" />

                <DataGridTextColumn Header="Handles"
                                    Width="90"
                                    Binding="{Binding HandleCount}" />

                <DataGridTextColumn Header="Threads"
                                    Width="90"
                                    Binding="{Binding ThreadCount}" />

            </DataGrid.Columns>

        </DataGrid>

        <!-- STATUS BAR -->

        <Grid Grid.Row="3"
              Margin="0,10,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>

                <TextBlock Text="{Binding Status}"
                           Foreground="#C9D3E5"/>

                <TextBlock Text="{Binding DatabasePath}"
                           Foreground="#71809A"
                           FontSize="11"/>

            </StackPanel>

            <TextBlock Grid.Column="1"
                       Foreground="White"
                       FontSize="18">

                <Run Text="Current CPU: "/>
                <Run Text="{Binding TotalCpuPercent,StringFormat=F2}"/>
                <Run Text="%"/>

            </TextBlock>

        </Grid>

    </Grid>

</Window>